    <!-- Facilities Assistant -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h3 class="h5 fw-bold">Facilities Assistant</h3>
            <br />
            <h4 class="h6 text-muted mb-3">
                University of Warwick • September 2023 – Present
            </h4>

            <p>
                This role focuses on sorting and processing post and parcels for staff and
                students at the university. I also occasionally assist with portering tasks
                such as moving furniture, equipment, or luggage.
            </p>

            <h5 class="h6 fw-bold mt-3">Typical duties include:</h5>
            <ul>
                <li>Process post and parcels onto the computer system</li>
                <li>Sort post and parcels by collection hub</li>
                <li>Assist in loading delivery vehicles</li>
                <li>Drive or assist a driver in delivering to hubs</li>
                <li>Organise post and parcels onto shelving</li>
                <li>Assist staff and students with collections and queries</li>
                <li>Audit hubs to ensure accurate processing</li>
                <li>Provide excellent customer service</li>
            </ul>
        </div>
    </div>

